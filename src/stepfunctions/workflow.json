{
  "Comment": "Estructura inicial temporal de la Step Function",
  "StartAt": "Iniciando Pipeline",
  "States": {
    "Iniciando Pipeline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:232791540625:alert-notification-pipeline",
        "Message": {
          "Message.$": "States.Format('🚀 Pipeline Iniciado\n\n🔹 State Machine: {}\n🔹 ID Ejecucion: {}\n🔹 Hora de Inicio: {}\n\n📍 Estado: Iniciando ejecucion...\n\n📝 Descripcion: Iniciando orquestacion para procesar logs de ecommerce.', $$.StateMachine.Name, $$.Execution.Name, $$.Execution.StartTime)"
        }
      },
      "Comment": "sns para enviar notificaciones al email cuando se ejecute el pipeline todas las noches",
      "Next": "Identificar Datos S3"
    },
    "Identificar Datos S3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:us-east-1:232791540625:function:check-new-data-s3:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Comment": "Lambda para identificar datos de bronze para transformar",
      "Next": "Decision Steps"
    },
    "Decision Steps": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.continuar",
          "BooleanEquals": true,
          "Next": "identificar Datos"
        }
      ],
      "Default": "SNS Publish"
    },
    "identificar Datos": {
      "Type": "Task",
      "Parameters": {
        "Name": "crawler-identity-brz"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Next": "Wait"
    },
    "Wait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "GetCrawler"
    },
    "GetCrawler": {
      "Type": "Task",
      "Parameters": {
        "Name": "crawler-identity-brz"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Next": "Choice",
      "ResultPath": "$.CrawlerStatus"
    },
    "Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.CrawlerStatus.Crawler.State",
          "StringMatches": "READY",
          "Next": "Transform Silver"
        }
      ],
      "Default": "Wait"
    },
    "Transform Silver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "job-ecommerce-logs"
      },
      "Comment": "Job para transformar datos e insertar de bronze a silver",
      "ResultPath": "$.SilverJobStatus",
      "Next": "Succed"
    },
    "Succed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:232791540625:alert-notification-pipeline",
        "Message": {
          "Message": "Funciono Orquestador hasta AWS GLUE JOB"
        }
      },
      "End": true
    },
    "SNS Publish": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:232791540625:alert-notification-pipeline",
        "Message": {
          "message": "No hay Datos"
        }
      },
      "End": true
    }
  }
}